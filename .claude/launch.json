{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "web:dev"],
			"port": 3000
		},
		{
			"name": "app-in-browser",
			"runtimeExecutable": "npx",
			"runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
			"cwd": "apps/mobile",
			"port": 8081
		},
		{
			"name": "api-lan",
			"runtimeExecutable": "npx",
			"runtimeArgs": ["next", "dev", "-p", "3001", "-H", "0.0.0.0"],
			"cwd": "apps/web",
			"port": 3001
		},
		{
			"name": "expo-go",
			"runtimeExecutable": "node",
			"runtimeArgs": ["../../node_modules/expo/bin/cli", "start", "--go", "--lan", "--clear"],
			"cwd": "apps/mobile",
			"port": 8081
		}
	]
}
