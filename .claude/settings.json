{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.dev)",
      "Read(./**/.env.dev)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.preview)",
      "Read(./**/.env.preview)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.prod)",
      "Read(./**/.env.prod)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/session-brief.py\""
          }
        ]
      }
    ]
  }
}
