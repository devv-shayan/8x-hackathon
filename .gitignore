# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
.next/
.expo/
.expo-shared/
.turbo/
*.tsbuildinfo

# Native build artifacts
apps/mobile/ios/
apps/mobile/android/
ios/Pods/
ios/build/
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/.idea/
android/local.properties
*.keystore
!debug.keystore

# Mobile signing / provisioning (NEVER commit)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Env files (NEVER commit — see *.example files instead). The same names
# .claude/settings.json denies reading; .env.example is the committed template.
.env
.env.local
.env.*.local
.env.dev
.env.development
.env.test
.env.staging
.env.preview
.env.prod
.env.production
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel

# Supabase local dev — matched at any depth, so a nested supabase/ project
# (apps/*/supabase) can't leak its CLI state either.
**/supabase/.branches/
**/supabase/.temp/

# Test coverage
coverage/

# Misc
*.tgz

# Agent worktrees: Claude Code checks each one out inside this repo, and
# `git add -A` would otherwise commit them as embedded repositories.
.claude/worktrees/

# NOTE: .claude-logs/ is intentionally COMMITTED in a play — build logs ride to GitHub.
# The template itself keeps none: log-session.py writes nothing while the root
# package is named app-template, and check:template fails if one is tracked.

# Claude Code's personal settings: each engineer's own permission approvals.
# The shared ones are .claude/settings.json, which is committed.
.claude/settings.local.json
