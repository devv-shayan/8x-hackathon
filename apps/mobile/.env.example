# apps/mobile environment. Copy to .env.local and fill in; never commit .env.local.
# lib/env.ts is the full list, and `npm run check:env` fails if the two drift. Every
# EXPO_PUBLIC_ value ships inside the app: nothing secret ever gets that prefix. Store
# builds and OTA updates read EAS environment variables instead (README.md,
# "Environment variables"). An empty value switches that feature off.

# ─── Supabase (sign-in only) ─────────────────────────────────────────────────
# Local dev: `supabase start` (or `supabase status`) prints the API URL, on the
# [api] port in supabase/config.toml, and the publishable key (sb_publishable_…).
# Android emulator: 10.0.2.2 instead of 127.0.0.1; a real phone: your LAN address.
# Production: the hosted project's URL and publishable key, set as EAS environment
# variables (Supabase dashboard → Project Settings).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, read only when the publishable key above is unset. Leave it unset.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── RevenueCat ──────────────────────────────────────────────────────────────
# From RevenueCat dashboard → Project → API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# ─── Sentry ──────────────────────────────────────────────────────────────────
# From sentry.io → Project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# Auth token for source map uploads during a local release build. On EAS it is a
# `secret` EAS environment variable, never a value in eas.json.
SENTRY_AUTH_TOKEN=

# ─── PostHog ─────────────────────────────────────────────────────────────────
# From posthog.com → Project → Settings → Project API Key
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── 8xResearch interview widget ─────────────────────────────────────────────
# This app's product key from 8xResearch (18 hex characters, from your
# 8xResearch account, one key per app). Public by design. Unset, the widget is off and builds
# ask for no microphone. Set it for a build, not only an update: the build adds
# the microphone permissions (research-widget.plugin.js). AGENTS.md has the steps.
EXPO_PUBLIC_RESEARCH_PRODUCT_KEY=

# ─── The web app (apps/web) ──────────────────────────────────────────────────
# Every read and write the app makes goes through its /api/app/v1, e.g.
# http://127.0.0.1:3000 locally (npm run web:dev). Unset, the app's screens say
# "Not connected yet".
EXPO_PUBLIC_SITE_URL=
