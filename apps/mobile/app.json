{
	"expo": {
		"name": "MyApp",
		"slug": "my-app",
		"version": "1.0.0",
		"runtimeVersion": { "policy": "fingerprint" },
		"updates": {
			"url": "https://u.expo.dev/REPLACE_WITH_YOUR_EAS_PROJECT_ID",
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0,
			"requestHeaders": { "expo-channel-name": "production" }
		},
		"orientation": "portrait",
		"scheme": "myapp",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#090f1e"
		},
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "com.yourcompany.myapp",
			"usesAppleSignIn": true,
			"privacyManifests": {
				"NSPrivacyAccessedAPITypes": [
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
						"NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
						"NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
						"NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
						"NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
					}
				]
			}
		},
		"android": {
			"package": "com.yourcompany.myapp",
			"adaptiveIcon": {
				"foregroundImage": "./assets/icon.png",
				"backgroundColor": "#090f1e"
			},
			"permissions": [],
			"blockedPermissions": [
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.CAMERA",
				"android.permission.RECORD_AUDIO"
			],
			"androidStatusBar": {
				"barStyle": "light-content",
				"backgroundColor": "#090f1e",
				"translucent": true
			},
			"predictiveBackGestureEnabled": false,
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [{ "scheme": "myapp" }],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"web": {
			"favicon": "./assets/icon.png"
		},
		"plugins": [
			"expo-router",
			"expo-image",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#090f1e",
					"image": "./assets/splash-icon.png",
					"imageWidth": 200
				}
			],
			"expo-secure-store",
			"expo-apple-authentication",
			[
				"./research-widget.plugin.js",
				{
					"//": "Adds the microphone only when EXPO_PUBLIC_RESEARCH_PRODUCT_KEY is set for the build (AGENTS.md, \"In-app interviews\"). Keep it above expo-image-picker so this string wins; if the app also films video, say both uses here.",
					"microphonePermission": "$(PRODUCT_NAME) uses the microphone only when you choose to answer a research interview by voice."
				}
			],
			[
				"expo-image-picker",
				{
					"//": "🎨 REPLACE: say what YOUR app does with photos, the camera and the microphone, with an example (Apple 5.1.1). iOS keeps all three strings: the picker's code can ask for each. Android declares only what the app uses: picking photos needs no permission (the system photo picker), so storage stays blocked; unblock CAMERA (and RECORD_AUDIO for video) in android.blockedPermissions when a screen calls launchCameraAsync.",
					"photosPermission": "$(PRODUCT_NAME) opens your photo library when you pick a photo to upload, like a profile picture. Only the photos you pick are shared with the app.",
					"cameraPermission": "$(PRODUCT_NAME) uses your camera when you choose to take a photo to upload, like a profile picture.",
					"microphonePermission": "$(PRODUCT_NAME) records sound only while you film a video to upload."
				}
			],
			"expo-localization",
			"expo-font",
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"project": "react-native",
					"organization": "your-org"
				}
			],
			"@sentry/react-native",
			"expo-web-browser"
		],
		"extra": {
			"router": {}
		},
		"owner": "REPLACE_WITH_YOUR_EXPO_OWNER"
	}
}
