# apps/web environment. Copy to .env.local and fill in; never commit .env.local.
# Generated from src/lib/env.ts: every variable here is declared there, and
# `npm run check:env` fails if the two drift. Where to get each value, and what
# breaks without it: docs/ENV_SETUP.md.
#
# Every variable is optional. Unset, each feature no-ops, answers 503 or falls
# back to the default named beside it, so a fresh clone boots with this file as
# it is. The commented-out lines are variables that must stay unset rather than
# empty: an empty value would override the default (or, for SUPABASE_URL, the
# name it falls back to). Uncomment one only to give it a real value.

# ── Site ──────────────────────────────────────────────────────────────────────
# Your production URL, as a full URL. Unset: https://example.com.
# NEXT_PUBLIC_SITE_URL=

# ── Supabase (auth) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS: never expose it.
SUPABASE_SECRET_KEY=

# Google AI Studio key: reads videos through src/server/ai/gemini.ts. Unset, /api/app/v1/videos
# answers 503.
GEMINI_API_KEY=
# Legacy names, read only when the names above are unset.
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# Transaction pooler, port 6543, ending ?pgbouncer=true&connection_limit=1.
# Every read and write the app makes goes through it. Empty: nothing is recorded
# first-party, and every page or route that reads the database fails. A Vercel
# production build fails without a valid one (deploy-checks.mjs).
DATABASE_URL=
# Session pooler, port 5432, no query parameters. Only the Prisma CLI reads it,
# for migrations (npm run db:migrate); not needed on Vercel.
DIRECT_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent. Unset: info (silent under NODE_ENV=test).
# LOG_LEVEL=

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
# Unset: https://us.i.posthog.com. Keep in sync with the mobile app's host.
# NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_ID=
# Local only: pretend every request comes from this country (ISO 3166-1 alpha-2).
NEXT_PUBLIC_DEV_COUNTRY=

# ── Stats dashboard + lifecycle events (optional) ─────────────────────────────
# Play Stats API bearer key, shared with the dashboard. Empty: the API answers 503.
DASHBOARD_API_KEY=
# This play's slug on the dashboard. Unset: app.
# PLAY_SLUG=
# Play Events API: where lifecycle events go (your email/automation platform).
# Server-only, write-only. Either one empty: no lifecycle event is sent.
PLAY_INGEST_KEY=
PLATFORM_BASE_URL=

# ── The app's minimum-version gate (GET /api/app/v1/config) ───────────────────
# The oldest native app version still supported, per platform, e.g. 1.3.0, and
# the store listing the "Update required" screen links to (https, required
# when that platform's minimum is set). Unset: no minimum. Never raise a
# minimum above a build that is in App Review. See docs/rules/ota.md.
APP_MIN_VERSION_IOS=
APP_STORE_URL_IOS=
APP_MIN_VERSION_ANDROID=
APP_STORE_URL_ANDROID=

# ── Cron and webhooks ─────────────────────────────────────────────────────────
# vercel.json runs /api/cron/lifecycle daily with it. Empty: the route answers 503.
CRON_SECRET=
# Empty: the RevenueCat webhook refuses every event with a 503 and writes
# nothing. A Vercel production build fails without a valid one: 32+ visible
# ASCII characters (openssl rand -hex 32). In RevenueCat → Integrations →
# Webhooks, set the Authorization header to `Bearer <this value>`, literally.
REVENUECAT_WEBHOOK_SECRET=
