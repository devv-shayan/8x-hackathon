{
	"name": "@app/web",
	"version": "0.1.0",
	"private": true,
	"description": "Next.js marketing site + admin panel + backend API routes.",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --import ./scripts/register-ts.mjs --test \"src/**/*.test.mts\"",
		"test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --import ./scripts/register-ts.mjs --test --test-concurrency=1 \"src/server/db/**/*.test.mts\"",
		"db:migrate": "prisma migrate deploy",
		"prisma:generate": "prisma generate",
		"postinstall": "prisma generate"
	},
	"prisma": {
		"schema": "prisma/schema"
	},
	"dependencies": {
		"@app/brand": "*",
		"@app/contract": "*",
		"@google/genai": "^2.32.0",
		"@prisma/client": "^6.19.3",
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.100.0",
		"@vercel/analytics": "^2.0.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.460.0",
		"motion": "^13.4.2",
		"next": "^15.5.28",
		"pino": "^10.3.1",
		"posthog-js": "^1.205.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"server-only": "^0.0.1",
		"tailwind-merge": "^2.5.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/react": "~19.2.2",
		"@types/react-dom": "~19.2.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.17.0",
		"eslint-config-next": "^15.5.28",
		"postcss": "^8.5.0",
		"prisma": "^6.19.3",
		"tailwindcss": "^3.4.19",
		"typescript": "~5.9.2"
	},
	"engines": {
		"node": ">=22.18.0 <23"
	}
}
