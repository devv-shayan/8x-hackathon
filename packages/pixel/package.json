{
	"name": "@app/pixel",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The dithered pixel art both apps draw: seeded noise, the generative backgrounds and Maya and Omar. Pure TypeScript with no React or DOM, so the website, the app and scripts share one engine.",
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": "./index.ts",
		"./backdrop-html": "./src/backdrop-html.generated.ts"
	},
	"scripts": {
		"build:icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../apps/web/scripts/register-ts.mjs scripts/build-icons.mjs",
		"build:backdrop": "node scripts/build-backdrop.mjs",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../apps/web/scripts/register-ts.mjs --test \"src/**/*.test.mts\"",
		"typecheck": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"typescript": "~5.9.2",
		"pngjs": "^3.4.0"
	}
}
